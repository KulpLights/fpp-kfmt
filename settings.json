{
    "settingGroups": {
        "KFMTRadio": {
            "description": "Radio Settings",
            "settings": [
                "Frequency",
                "Preemphasis",
                "IdleAction",
                "TransmitPower",
                "InputImpedance",
                "TXDigitalGain",
                "TXInputBufferGain"
            ]
        },
        "KFMTRDSSettings": {
            "description": "RDS Settings",
            "settings": [
                "RDSEnable",
                "ProgramType",
                "StationCode",
                "StationID",
                "StationIDTime",
                "StationName",
                "StationURL",
                "AfterHoursRDS"
            ]
        }
    },
    "settings": {
        "IdleAction": {
            "name": "IdleAction",
            "description": "Playlist Idle Behavior",
            "tip": "What to do if a playlist is not playing. Leave Alone and Mute keep the FM carrier on; Disable Carrier turns it off.",
            "restart": 0,
            "reboot": 0,
            "type": "select",
            "default": 0,
            "options": {
                "Leave Alone": 0,
                "Mute": 1,
                "Disable Carrier": 2
            }
        },
        "Preemphasis": {
            "name": "Preemphasis",
            "description": "Preemphasis",
            "tip": "Preemphasis",
            "restart": 0,
            "reboot": 0,
            "type": "select",
            "default": 1,
            "options": {
                "50us (Europe, Australia, Japan)": 0,
                "75us (USA, default)": 1
            }
        },
        "Frequency": {
            "name": "Frequency",
            "description": "FM Frequency",
            "tip": "FM frequency to broadcast on. Pick a channel that is clear where you live - radio-locator.com has a vacant-channel search that lists the unused ones for your area.",
            "restart": 0,
            "reboot": 0,
            "type": "text",
            "default": "87.9",
            "size": 6,
            "maxlength": 6
        },
        "StationID": {
            "name": "StationID",
            "description": "Station ID",
            "tip": "Station Identifier, sent as rotating 8-character RDS screens. Each preview box is one screen. Spaces are shown as \u00b7 so padding is visible; they still save as spaces. Placeholders like {Title} count as typed characters here and expand when a song plays. Station ID Display Time is how long each screen stays.",
            "restart": 0,
            "reboot": 0,
            "type": "text",
            "default": "Merry   Christ- mas",
            "size": 30,
            "maxlength": 100
        },
        "StationIDTime": {
            "name": "StationIDTime",
            "description": "Station ID Display Time",
            "tip": "Time (s) that each 8 character section of the station ID is displayed.",
            "restart": 0,
            "reboot": 0,
            "type": "number",
            "default": 5,
            "min": 1,
            "max": 60
        },
        "StationName": {
            "name": "StationName",
            "description": "Station Name",
            "tip": "Longer Station Name for RT+.  Max of 60 characters.",
            "restart": 0,
            "reboot": 0,
            "type": "text",
            "default": "Merry Christmas FM",
            "size": 60,
            "maxlength": 60
        },
        "StationURL": {
            "name": "StationURL",
            "description": "Station URL",
            "tip": "Station Homepage URL for RT+.  Max of 60 characters.",
            "restart": 0,
            "reboot": 0,
            "type": "text",
            "default": "",
            "size": 60,
            "maxlength": 60
        },
        "StationCode": {
            "name": "StationCode",
            "description": "Station Code",
            "tip": "Station Code, 4 character string, all upper case. If the first letter must be W or K, it will be automatically calculated based on US formulas.  Otherwise it must be a hex string.",
            "restart": 0,
            "reboot": 0,
            "type": "text",
            "default": "WFPP",
            "size": 6,
            "maxlength": 4
        },
        "TransmitPower": {
            "name": "TransmitPower",
            "description": "Transmit Power",
            "tip": "Transmit power 1\u2013100, mapped across the QN8027 PA range (about 83\u2013117 dB\u00b5V). Higher values increase range but also increase distortion.",
            "restart": 0,
            "reboot": 0,
            "type": "number",
            "default": 50,
            "min": 1,
            "max": 100
        },
        "InputImpedance": {
            "name": "InputImpedance",
            "description": "Audio Input Impedance",
            "tip": "Audio Input Impedance (k ohms).",
            "restart": 0,
            "reboot": 0,
            "level": 1,
            "type": "select",
            "default": 20,
            "options": {
                "5 k ohms": 5,
                "10 k ohms": 10,
                "20 k ohms": 20,
                "40 k ohms": 40
            }
        },
        "TXDigitalGain": {
            "name": "TXDigitalGain",
            "description": "TX Digital Gain",
            "tip": "Transmit Digital Gain (0dB - 2dB). Higher values increase range but also increase distortion.",
            "restart": 0,
            "reboot": 0,
            "type": "number",
            "default": 0,
            "min": 0,
            "max": 2,
            "level": 1
        },
        "TXInputBufferGain": {
            "name": "TXInputBufferGain",
            "description": "TX Input Buffer Gain",
            "tip": "Transmit Input Buffer Gain (0-5). Higher values increase range but also increase distortion.",
            "restart": 0,
            "reboot": 0,
            "type": "number",
            "default": 3,
            "min": 0,
            "max": 5,
            "level": 1
        },
        "RDSEnable": {
            "name": "RDSEnable",
            "description": "RDS",
            "tip": "Send RDS (station name, song info, RT+) on the FM signal. Off leaves the audio carrier unchanged but radios will not show text.",
            "restart": 0,
            "reboot": 0,
            "type": "select",
            "default": 1,
            "options": {
                "On": 1,
                "Off": 0
            }
        },
        "ProgramType": {
            "name": "ProgramType",
            "description": "Program Type (PTY North America / Europe)",
            "tip": "Program Type.",
            "restart": 0,
            "reboot": 0,
            "type": "select",
            "default": 0,
            "options": {
                "0 - None / None": 0,
                "1 - News / News": 1,
                "2 - Information / Current Affairs": 2,
                "3 - Sport / Information": 3,
                "4 - Talk / Sport": 4,
                "5 - Rock / Education": 5,
                "6 - Classic Rock / Drama": 6,
                "7 - Adult Hits / Culture": 7,
                "8 - Soft Rock / Science": 8,
                "9 - Top 40 / Varied": 9,
                "10 - Country / Pop": 10,
                "11 - Oldies / Rock": 11,
                "12 - Soft Music / Easy Listening": 12,
                "13 - Nostalgia / Light Classical": 13,
                "14 - Jazz / Serious Classical": 14,
                "15 - Classical / Other Music": 15,
                "16 - R&B / Weather": 16,
                "17 - Soft R&B / Finance": 17,
                "18 - Language / Childrens": 18,
                "19 - Religious Music / Social Affairs": 19,
                "20 - Religious Talk / Religion": 20,
                "21 - Personality / Phone-In": 21,
                "22 - Public / Travel": 22,
                "23 - College / Leisure": 23,
                "24 - Spanish Talk / Jazz": 24,
                "25 - Spanish Music / Country": 25,
                "26 - Hip hop / National Music": 26,
                "27 - --- / Oldies": 27,
                "28 - --- / Folk": 28,
                "29 - Weather / Documentary": 29
            }
        },
        "AfterHoursRDS": {
            "name": "AfterHoursRDS",
            "description": "After Hours Track Info",
            "tip": "When no playlist is running, take the track title from the After Hours Music Player's stream and send it as RDS text, instead of the static station text. Only appears when that plugin's mpc command is installed.",
            "restart": 0,
            "reboot": 0,
            "type": "select",
            "default": 0,
            "options": {
                "On": 1,
                "Off": 0
            },
            "checkFile": [
                "/usr/bin/mpc",
                "/bin/mpc",
                "/usr/local/bin/mpc"
            ]
        }
    }
}
